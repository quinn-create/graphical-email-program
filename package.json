{
  "name": "mattermail-review",
  "private": true,
  "version": "0.1.0",
  "description": "MatterMail Review — Gmail review and Clio matter assignment desktop app",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @mattermail/desktop dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @mattermail/desktop build",
    "dist:win": "pnpm --filter @mattermail/desktop dist:win",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 100",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @mattermail/desktop test:e2e",
    "safety-check": "tsx scripts/safety-check.ts",
    "db:generate": "pnpm --filter @mattermail/database generate",
    "db:migrate": "pnpm --filter @mattermail/database migrate"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@mattermail/security": "workspace:*",
    "@mattermail/shared": "workspace:*"
  }
}
