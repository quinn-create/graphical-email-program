# MatterMail Review — environment variable NAMES only. Never commit real secrets.

# App
MATTERMAIL_PRODUCT_NAME=MatterMail Review
MATTERMAIL_DATA_DIR=
MATTERMAIL_DEMO_MODE=true
MATTERMAIL_TIMEZONE_DISPLAY=America/New_York

# Google OAuth (Gmail read-only + Drive file scope)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:42813/oauth/callback

# Clio Manage OAuth (private app)
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:42814/oauth/callback
CLIO_BASE_URL=https://app.clio.com
CLIO_REGION=

# AI provider keys are stored in the OS credential store / Electron safeStorage.
# Do not put API keys here for normal use. Names for documentation only:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# OLLAMA_API_KEY=
